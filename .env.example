# Eesa QuickBooks plugin — environment.
#
# There are no QuickBooks OAuth credentials here on purpose. The Intuit app id
# and secret live on the Eesa server (QB_OAUTH_CLIENT_ID / QB_OAUTH_CLIENT_SECRET),
# which runs the consent flow and holds each tenant's tokens. This plugin asks
# Eesa for a live access token per call and stores nothing.

# ---- Talking to Eesa (all three are required) ------------------------------

# Where to verify the RS256 tokens Eesa presents. NOTE: no trailing slash — a
# proxy that appends one turns every verification into a 404 that reads like a
# signing-key problem.
EESA_JWKS_URL=https://api.eesa.ai/api/v1/.well-known/jwks.json

# Where to resolve per-tenant QuickBooks credentials (and the same origin the
# JWKS is served from).
EESA_API_BASE=https://api.eesa.ai

# Shared secret proving a call came through Eesa's broker rather than straight
# off the internet. Must match the platform's PLUGIN_GATEWAY_SECRET. Also used
# to authenticate this plugin's credential lookups back to Eesa.
PLUGIN_GATEWAY_SECRET=

# Token issuer claim. Only change this if the platform's DOWNSTREAM_TOKEN_ISSUER
# was changed too.
EESA_TOKEN_ISSUER=eesa

# Where to send an admin who needs to connect QuickBooks. Shown in the app page.
EESA_APP_BASE=https://app.eesa.ai

# ---- Write protection ------------------------------------------------------
#
# Set to "true" to unregister that whole class of tools — they then do not
# appear in tools/list and cannot be called by name. The image defaults all
# three to true. Turn one off only when posting to QuickBooks is deliberately
# being enabled, and note that a tenant ALSO needs the quickbooks:write scope on
# their connection before the agent may use them.
QUICKBOOKS_DISABLE_WRITE=true
QUICKBOOKS_DISABLE_UPDATE=true
QUICKBOOKS_DISABLE_DELETE=true

# Let the agent write on a tenant's behalf WITHOUT a named user.
#
# Agent-path tokens carry sub="gateway" and no user identity — the platform
# mints them per tenant, and only derives a per-user appRole for the attendance
# plugin. So by default the plugin refuses mutations from the agent rather than
# posting to a company's books with nobody to attribute it to.
#
# Set this to "true" only if that trade is acceptable for this deployment. It
# does nothing while the three switches above are on.
QUICKBOOKS_AGENT_MAY_WRITE=false

# ---- Permissions store -----------------------------------------------------
#
# Postgres holding ONE table: who in each workspace may use QuickBooks, and how
# much (db/schema.sql). No credentials are stored here — Eesa's broker owns
# those. Apply the schema with `npm run schema`.
#
# Without it the Permissions tab cannot save, and access falls back to Eesa's
# own grants plus workspace admins.
DATABASE_URL=
# Set to "disable" for a plain local or Coolify-hosted Postgres; managed
# Postgres (Supabase/Neon/RDS) needs SSL, which is the default.
# PGSSL=disable

# ---- Optional --------------------------------------------------------------

PORT=8080

# Largest invoice PDF returned inline, in bytes. Default 8 MiB.
# QBO_PDF_MAX_BYTES=8388608

# Timeout when downloading a file_url for an attachment, in ms. Default 60000.
# QUICKBOOKS_ATTACHABLE_URL_TIMEOUT_MS=60000

# Local development only: skip the gateway-secret check so you can POST /mcp
# without running Eesa. Never set this in a deployment — it removes the check
# the manifest advertises.
# ALLOW_UNGATED_MCP=1
